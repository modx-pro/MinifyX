{
    "name": "modx-extra/minifyx",
    "description": "MODX Extra for combining, compiling and minifying CSS/JS and on-the-fly image processing",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "matthiasmullie/minify": "^1.3.75",
        "scssphp/scssphp": "^2.0",
        "wikimedia/less.php": "^5.0",
        "intervention/image": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-gd": "Required for image processing with the GD driver",
        "ext-imagick": "Optional Imagick driver for image processing"
    },
    "autoload": {
        "psr-4": {
            "MinifyX\\": "src/"
        },
        "classmap": [
            "model/minifyx/minifyx.class.php"
        ],
        "files": [
            "src/Legacy/CoffeeScript/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MinifyX\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
